# Vitiligo Initiative — environment configuration
# Copy to .env and fill in. .env is gitignored.

# --- NCBI E-utilities (PubMed) ---
# Free API key, recommended for higher rate limits (10 req/sec with key, 3 req/sec without).
# Register at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# Required by NCBI for any programmatic use — be honest, they actually look.
NCBI_TOOL=vitiligo-initiative
NCBI_EMAIL=

# --- Storage ---
# SQLite path (relative to project root). Default: data/vitiligo.db
VITILIGO_DB_PATH=data/vitiligo.db

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- LLM (reasoning layer) ---
# Anthropic API key — required for `vitiligo ask` and `vitiligo hypothesize`,
# and for the /api/ask and /api/hypothesize endpoints in the web UI.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-4-5 (good balance of cost and quality).
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Web UI / deployment ---
# Host/port for `vitiligo serve`. Render and similar hosts inject PORT automatically.
VITILIGO_WEB_HOST=127.0.0.1
VITILIGO_WEB_PORT=8765
# POST /api/* requests per IP per minute (0 disables). Default in production: 30.
VITILIGO_RATE_LIMIT_POST_PER_MINUTE=30
# Reverse proxies in front of the app (0 = none; rate limits key on the TCP peer).
# Behind one proxy (e.g. Render) use 1. Never set higher than the real proxy count:
# X-Forwarded-For entries beyond it are client-controlled.
VITILIGO_TRUSTED_PROXY_HOPS=0
# Global caps on the paid Ask/Hypothesize endpoints across ALL clients (0 disables).
# Per-IP limits cannot stop many clients; these protect the Anthropic bill.
# State is kept in VITILIGO_STATE_DB_PATH (default: vitiligo-state.db next to the corpus).
VITILIGO_LLM_REQUESTS_PER_MINUTE=0
VITILIGO_LLM_DAILY_TOKEN_BUDGET=0
# Load fastembed at startup (recommended for Docker / Render / production hosts).
VITILIGO_PREWARM_EMBEDDINGS=true
# Optional ONNX model cache (e.g. /data/cache on a persistent host volume).
# FASTEMBED_CACHE_PATH=/data/cache
