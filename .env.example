# Vitiligo Initiative — environment configuration
# Copy to .env and fill in. .env is gitignored.

# --- NCBI E-utilities (PubMed) ---
# Free API key, recommended for higher rate limits (10 req/sec with key, 3 req/sec without).
# Register at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# Required by NCBI for any programmatic use — be honest, they actually look.
NCBI_TOOL=vitiligo-initiative
NCBI_EMAIL=

# --- Storage ---
# SQLite path (relative to project root). Default: data/vitiligo.db
VITILIGO_DB_PATH=data/vitiligo.db

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- LLM (reasoning layer) ---
# Anthropic API key — required for `vitiligo ask` and `vitiligo hypothesize`,
# and for the /api/ask and /api/hypothesize endpoints in the web UI.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-4-5 (good balance of cost and quality).
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Web UI ---
# Host/port for `vitiligo serve`. Defaults: 127.0.0.1:8765
VITILIGO_WEB_HOST=127.0.0.1
VITILIGO_WEB_PORT=8765
